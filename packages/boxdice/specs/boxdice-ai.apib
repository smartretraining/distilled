                    "consultant_id": 1,
                    "contact_ids": [],
                    "notes": "Regarding another task"
                }
            ],
            "paging": {
                "next": "https://your-domain.boxdice.com.au/ai_api/tasks?after=1547774654_4"
            }
        }

### Create Tasks [POST]

This endpoint can be used to create multiple tasks. The response will contain an array of ids/errors. The position of the id/error in the array in the response matches the position of the item that was submitted.

---
**Task attributes:**
- subject `(String, required)`
- contact_ids `(Number Array, required)`
- action_date `(Date, required)`
- consultant_id `(Number, required)`
- kind `(String, required)` - one of:
  - Phone
  - Email
  - SMS
  - Letter
  - Task
  - Web enquiry
  - Others

---


+ Request (application/json)

    + Headers

            Authorization: Api-Key token=b3c7623c3ad30d34fec6226f90914b0af125dc06

    + Body

            {
              "tasks": [
                {
                  "subject": "foobar",
                  "contact_ids": [1],
                  "action_date": "2021-01-01",
                  "kind": "SMS",
                  "consultant_id": 1,
                },
                {
                  "subject": "foobar",
                  "contact_ids": [2],
                  "action_date": "2021-01-01",
                  "kind": "SMS",
                  "consultant_id": null,
                }
              ]
            }
+ Response 200 (application/json)

        
        [
            {"id": 7352},
            {"errors": { "consultant": ["can't be blank"] }}
        ]

