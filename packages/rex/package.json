{
  "name": "@smartretraining/rex-effect",
  "version": "0.8.0",
  "description": "Effect-native SDK for the Rex Software real-estate API, generated from Rex's describe/describeModel introspection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartretraining/distilled.git",
    "directory": "packages/rex"
  },
  "homepage": "https://github.com/smartretraining/distilled/tree/main/packages/rex",
  "bugs": {
    "url": "https://github.com/smartretraining/distilled/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Webhooks": {
      "types": "./lib/webhooks.d.ts",
      "bun": "./src/webhooks.ts",
      "worker": "./src/webhooks.ts",
      "default": "./lib/webhooks.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json",
    "convert": "bun scripts/build-openapi.ts && bun scripts/convert.ts",
    "generate": "bun scripts/generate.ts",
    "specs:scrape": "bun scripts/scrape-specs.ts",
    "test": "bunx vitest run test"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "^16.5.0",
    "vitest": "^3.2.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 || >=4.0.0"
  }
}
