{
  "name": "@smartretraining/rex-effect",
  "version": "0.3.0",
  "description": "Effect-native SDK for the Rex Software real-estate API, generated from Rex's describe/describeModel introspection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartretraining/distilled.git",
    "directory": "packages/rex"
  },
  "homepage": "https://github.com/smartretraining/distilled/tree/main/packages/rex",
  "bugs": {
    "url": "https://github.com/smartretraining/distilled/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Category": {
      "types": "./lib/category.d.ts",
      "bun": "./src/category.ts",
      "default": "./lib/category.js"
    },
    "./Client": {
      "types": "./lib/client.d.ts",
      "bun": "./src/client.ts",
      "default": "./lib/client.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Operations": {
      "types": "./lib/operations/index.d.ts",
      "bun": "./src/operations/index.ts",
      "default": "./lib/operations/index.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Sensitive": {
      "types": "./lib/sensitive.d.ts",
      "bun": "./src/sensitive.ts",
      "default": "./lib/sensitive.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Webhooks": {
      "types": "./lib/webhooks.d.ts",
      "bun": "./src/webhooks.ts",
      "default": "./lib/webhooks.js"
    }
  },
  "scripts": {
    "typecheck": "tsgo",
    "build": "tsgo -b",
    "fmt": "oxfmt --write src",
    "lint": "oxlint --fix src",
    "check": "tsgo && oxlint src && oxfmt --check src",
    "test": "bunx vitest run test --exclude specs --passWithNoTests",
    "prepublishOnly": "bun run build",
    "publish:npm": "bun run build && bun publish",
    "specs:scrape": "bun run scripts/scrape-specs.ts",
    "build:openapi": "bun run scripts/build-openapi.ts",
    "generate": "bun run scripts/build-openapi.ts && bun run scripts/generate.ts && oxlint --fix src && oxfmt --write src && oxfmt --write src"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
