{
  "result": {
    "search_result_formats": [
      {
        "id": "default",
        "description": "The default response format containing preselected fields.",
        "limit": 100
      },
      {
        "id": "etags",
        "description": "Constructs unique etags for record ids that represent a record at a given time. If the etag has changed the next time you request etags you should request the full record.",
        "limit": 50000
      },
      {
        "id": "ids",
        "description": "Returns an array of id's only. Id sets are subject to much higher search result limits (10000 items per page).",
        "limit": 1000000
      },
      {
        "id": "default_no_stubs",
        "description": "The default response format containing preselected fields but not containing stubs.",
        "limit": 100
      },
      {
        "id": "map",
        "description": "Id, latitude and longitude. Ideal for displaying properties on a map.",
        "limit": 50000
      }
    ],
    "search_extra_options": {
      "extra_fields": {
        "description": "Including values from this option will increase the amount of data included in the response",
        "fields": {
          "core_attributes": "Multiple fields describing certain key attributes for different property types - e.g. bedrooms, bathrooms etc.",
          "status": "Status details relating to a property including current status, appraisal, oab, listing etc.",
          "active_appraisal": "The active appraisal related to this property, retrieved via Appraisals::search",
          "contact_reln_property": "Relationships the property has to any associated contacts",
          "stats": "An array of stats"
        }
      }
    },
    "delete_modes": [
      "archive",
      "trash"
    ],
    "data_structure": {
      "description": "This is not necessarily a full and accurate representation of the data model. For a full representation, query an existing record.",
      "structure": [
        "id",
        "account_id",
        "system_record_state",
        "system_ctime",
        "system_modtime",
        "system_owner_user_id",
        "system_modified_user_id",
        "system_created_user_id",
        "system_search_key",
        "system_order_key",
        "system_geo_location",
        "system_geocode_status",
        "adr_unit_number",
        "adr_street_number",
        "adr_street_name",
        "adr_suburb_or_town",
        "adr_locality",
        "adr_state_or_region",
        "adr_postcode",
        "adr_country",
        "adr_building_id",
        "adr_estate_name",
        "adr_estate_stage",
        "title_number",
        "property_image_uri",
        "property_category_id",
        "property_subcategory_id",
        "meta_rates_business",
        "meta_rates_council",
        "meta_rates_bodycorp",
        "meta_rates_water",
        "meta_rates_land",
        "meta_rates_other",
        "meta_parking_notes",
        "meta_zone",
        "meta_tax_band",
        "meta_council_authority",
        "is_dnd",
        "business_name",
        "meta_rates_domestic",
        "meta_rates_council_exempt",
        "system_owner_last_contacted_date"
      ]
    },
    "read_fields": {
      "core": "Returns core information about a record. This is technically always included regardless of what is passed in to read fields but this field allows you to explicitly request ONLY core data.",
      "property_detail": "Primary property attributes",
      "property_detailrural": "6 fields detailing additional rural attributes",
      "property_image": "The image set for the property (or if not specified)",
      "note": "A simple note that describes the property",
      "related.contact_reln_property": "Contacts that are related to the current property",
      "related.property_features": "Features available at the property",
      "related.property_views": "Views available at the property",
      "related.property_tags": "Tags associated with the property"
    },
    "read_extra_fields": {
      "appraisals": "The appraisals related to this property (including the past 10 archived appraisals), retrieved via Appraisals::search",
      "oabs": "The oabs related to this property (including the past 10 archived oabs), retrieved via Oabs::search",
      "history": "The history of this property combined from various locations in the system (past listing history, current listing history, appraisals, oabs)",
